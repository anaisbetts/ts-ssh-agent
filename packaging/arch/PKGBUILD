# Maintainer: Anaïs Betts <anais@anaisbetts.org>
pkgname=ts-ssh-agent
pkgver=0.0.0
pkgrel=1
pkgdesc='SSH agent backed by a key server in your tailnet'
arch=('x86_64' 'aarch64')
url='https://github.com/anaisbetts/ts-ssh-agent'
license=('MIT')
depends=('glibc')
makedepends=('go')
optdepends=('tailscale: to reach the key server from this machine')
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  go mod download -modcacherw
}

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS='-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw'
  # Command-line -ldflags overrides the GOFLAGS one above (last flag wins).
  go build -ldflags "-linkmode=external -X main.Version=$pkgver" -o build/ts-ssh-agent ./cmd/ts-ssh-agent
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/ts-ssh-agent "$pkgdir/usr/bin/ts-ssh-agent"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    packaging/systemd/ts-ssh-agent.service \
    packaging/systemd/ts-ssh-agent-server.service
  install -Dm644 packaging/post-install.txt "$pkgdir/usr/share/$pkgname/post-install.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
